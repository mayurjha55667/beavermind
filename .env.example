# Server-only Supabase connection. Never prefix the service role key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI is the first provider behind the LLMProvider interface.
LLM_PROVIDER=openai
LLM_API_KEY=your-openai-api-key
# Recommended balance of long context, structured output reliability, latency, and cost.
LLM_MODEL=gpt-5.4-mini
LLM_TIMEOUT_MS=180000

# Public origin used to construct persistent report URLs.
APP_BASE_URL=http://localhost:3000
